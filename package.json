{
  "name": "megaminds-ai-chat-dashboard",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "install:all": "npm install --workspace client",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "cd server && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 4000",
    "build:client": "npm run build --workspace client",
    "seed": "cd server && python seed.py"
  }
}
